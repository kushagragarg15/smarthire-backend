# Optional: enables GPT resume parsing. Without it a built-in keyword parser is used.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: MongoDB connection. Without it data is stored in data/*.json and resumes/.
MONGODB_URI=

# Recommended: any long random string, keeps recruiters logged in across restarts.
SECRET_KEY=

# Optional: recruiter logins as user:password pairs (defaults shown).
# RECRUITER_USERS=recruiter:smartHire2024,admin:admin123,hr:hr@2024

# Optional: restrict which frontends may call the API (default: any).
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.app
